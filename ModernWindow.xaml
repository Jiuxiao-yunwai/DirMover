<Window x:Class="DirMover.ModernWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DirMover" Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#CBD5E1"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Margin" Value="10,3"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#1E293B"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="#2563EB"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#2563EB"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="RowHeight" Value="30"/>
                <Setter Property="ColumnHeaderHeight" Value="34"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="VirtualizingPanel.CacheLength" Value="1,2"/>
                <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/>
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="BorderBrush" Value="#EEF2F7"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="ToolTip" Value="{Binding LinkTargetTooltip}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F1F6FF"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E7F0FF"/>
                        <Setter Property="Foreground" Value="#1D4ED8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#1D4ED8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F172A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="104"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="24,24,18,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#2563EB">
                            <TextBlock Text="D" Foreground="White" FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="DirMover" Foreground="White" FontWeight="SemiBold" FontSize="19"/>
                            <TextBlock Text="安全释放系统盘空间" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="工作区" Foreground="#64748B" FontSize="11"
                               FontWeight="SemiBold" Margin="26,12,0,8"/>
                    <RadioButton x:Name="SpaceNav" GroupName="Navigation" IsChecked="True"
                                 Style="{StaticResource NavButton}" Checked="SpaceNav_Checked">
                        <TextBlock Text="空间分析" VerticalAlignment="Center"/>
                    </RadioButton>
                    <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="MovesNav_Checked">
                        <TextBlock Text="迁移记录" VerticalAlignment="Center"/>
                    </RadioButton>
                    <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="LinksNav_Checked">
                        <TextBlock Text="链接检测" VerticalAlignment="Center"/>
                    </RadioButton>
                    <TextBlock Text="系统" Foreground="#64748B" FontSize="11"
                               FontWeight="SemiBold" Margin="26,18,0,8"/>
                    <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Checked="SettingsNav_Checked">
                        <TextBlock Text="设置" VerticalAlignment="Center"/>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="2" Margin="16" Padding="12,8" CornerRadius="9" Background="#162033">
                    <StackPanel>
                        <TextBlock Text="NTFS MFT 引擎" Foreground="#E2E8F0" FontSize="12"/>
                        <TextBlock Text="只读扫描 · 后台运行" Foreground="#64748B" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="26,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="空间分析" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock x:Name="PageSubtitle" Text="快速查看目录占用并选择需要迁移的内容"
                                   FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            CornerRadius="14" Padding="11,5" Background="#ECFDF5">
                        <TextBlock x:Name="PrivilegeText" Text="普通权限"
                                   Foreground="#047857" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,18">
                <Grid x:Name="SpaceView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PresetBox" Height="34" SelectedIndex="0"
                                      SelectionChanged="PresetBox_SelectionChanged">
                                <ComboBoxItem Content="本地 AppData"/>
                                <ComboBoxItem Content="漫游 AppData"/>
                                <ComboBoxItem Content="AppData LocalLow"/>
                                <ComboBoxItem Content="Program Files"/>
                                <ComboBoxItem Content="Program Files (x86)"/>
                                <ComboBoxItem Content="自选目录…"/>
                            </ComboBox>
                            <TextBox x:Name="RootPathText" Grid.Column="1" Height="34" Margin="12,0"
                                     IsReadOnly="True" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="扫描" Height="34" Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButton}" Click="Scan_Click"/>
                            <Button Grid.Column="3" Content="重新扫描" Height="34" Margin="0,0,8,0"
                                    Padding="14,7" Click="RefreshScan_Click"/>
                            <Button Grid.Column="4" Content="停止" Height="34" Margin="0,0,8,0"
                                    Padding="14,7" Click="Stop_Click"/>
                            <Button Grid.Column="5" Content="迁移选中项" Height="34"
                                    Style="{StaticResource PrimaryButton}" Click="Move_Click"/>
                        </Grid>
                    </Border>

                    <Border x:Name="ScanProgressPanel" Grid.Row="1" Style="{StaticResource Card}"
                            Margin="0,12,0,0" Padding="14,11" Visibility="Collapsed"
                            Background="#EFF6FF" BorderBrush="#BFDBFE">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ScanProgressText" Text="正在准备扫描…"
                                           Foreground="#1E40AF" FontSize="11" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="ScanProgressBar" Height="6" Margin="0,8,14,0"
                                             Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                            <TextBlock x:Name="ScanPercentText" Grid.Column="1" Text="0%"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="19" FontWeight="SemiBold" Foreground="#2563EB"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="#EEF2FF">
                                    <TextBlock Text="数量" Foreground="#4F46E5" FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="一级文件夹" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock x:Name="FolderCountText" Text="—" FontSize="21"
                                               FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="#ECFDF5">
                                    <TextBlock Text="逻辑" Foreground="#059669" FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="逻辑大小" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock x:Name="LogicalSizeText" Text="—" FontSize="21"
                                               FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="#EFF6FF">
                                    <TextBlock Text="占用" Foreground="#2563EB" FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="磁盘占用" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock x:Name="AllocatedSizeText" Text="—" FontSize="21"
                                               FontWeight="SemiBold" Foreground="#2563EB" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="White" BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1" Padding="16,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="目录明细" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#0F172A"/>
                                    <TextBlock Text="单击列标题排序，右键可打开或复制"
                                               FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                            <DataGrid Grid.Row="1" x:Name="FolderGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  Sorting="Grid_Sorting"
                                  PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                                  PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="在文件资源管理器中打开" Click="OpenSelected_Click"/>
                                    <MenuItem Header="复制选中内容" Click="CopySelected_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="文件夹"
                                                        SortMemberPath="Name" Width="2*">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell"
                                               BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Stretch"/>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="12,0,6,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="磁盘占用" Binding="{Binding AllocatedText}"
                                                    SortMemberPath="AllocatedBytes" Width="150"/>
                                <DataGridTextColumn Header="文件数" Binding="{Binding FileCountText}"
                                                    SortMemberPath="FileCount" Width="120"/>
                                <DataGridTemplateColumn Header="状态" SortMemberPath="DisplayStatus" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayStatus}"
                                                       ToolTip="{Binding LinkTargetTooltip}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="MovesView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="重新检查" Padding="15,8" Click="RefreshMoves_Click"/>
                            <Button Content="还原选中项" Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}" Click="Restore_Click"/>
                            <Button Content="打开记录位置" Margin="8,0,0,0"
                                    Padding="15,8" Click="OpenStore_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
                        <DataGrid x:Name="MoveGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                                  PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="在文件资源管理器中打开" Click="OpenSelected_Click"/>
                                    <MenuItem Header="复制选中内容" Click="CopySelected_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="150"/>
                                <DataGridTextColumn Header="原位置" Binding="{Binding Source}" Width="2*"/>
                                <DataGridTextColumn Header="新位置" Binding="{Binding Destination}" Width="2*"/>
                                <DataGridTextColumn Header="迁移时间" Binding="{Binding Created}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <Grid x:Name="LinksView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="选择目录并检测" Style="{StaticResource PrimaryButton}"
                                    Click="DetectLinks_Click"/>
                            <TextBlock Text="扫描不会进入链接目标，可避免循环和重复计算。"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
                        <DataGrid x:Name="LinkGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                                  PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="在文件资源管理器中打开" Click="OpenSelected_Click"/>
                                    <MenuItem Header="复制选中内容" Click="CopySelected_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110"/>
                                <DataGridTextColumn Header="链接位置" Binding="{Binding Path}" Width="2*"/>
                                <DataGridTextColumn Header="指向位置" Binding="{Binding Target}" Width="2*"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/>
                                <DataGridTextColumn Header="检测时间" Binding="{Binding DetectedText}" Width="145"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="SettingsWarning" Visibility="Collapsed"
                                Background="#FFF7ED" BorderBrush="#FED7AA"
                                BorderThickness="1" CornerRadius="12" Padding="16"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9"
                                        Background="#FFEDD5">
                                    <TextBlock Text="!" Foreground="#C2410C" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="只检测到系统盘" FontWeight="SemiBold"
                                               Foreground="#9A3412"/>
                                    <TextBlock Text="同一分区内迁移无法释放空间。统一托管已停用，请连接另一块 NTFS 磁盘后使用自定义迁移。"
                                               Foreground="#C2410C" Margin="0,3,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="统一托管位置" FontSize="18"
                                                   FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="迁移时按照来源目录自动生成 AppData、Program Files 等分类。"
                                                   Foreground="#64748B" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EEF2FF"
                                            CornerRadius="10" Padding="11,6"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="ManagedModeText" Text="自动选择"
                                                   Foreground="#4338CA" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0"
                                        BorderThickness="1" CornerRadius="11"
                                        Padding="14" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="本机磁盘" Foreground="#64748B"
                                                   FontSize="11"/>
                                        <TextBlock x:Name="DriveSummaryText"
                                                   Margin="0,5,0,0" Foreground="#334155"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="各来源托管位置" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#0F172A"
                                           Margin="0,18,0,8"/>
                                <ItemsControl x:Name="ManagedLocationList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                    BorderThickness="1" CornerRadius="9"
                                                    Padding="12,9" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#0F172A"/>
                                                        <TextBlock Text="{Binding ModeText}"
                                                                   FontSize="10"
                                                                   Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Path}"
                                                               Margin="12,0" FontFamily="Consolas"
                                                               Foreground="#334155"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Path}"/>
                                                    <Button Grid.Column="2" Content="更改"
                                                            Tag="{Binding Key}" Padding="13,6"
                                                            Click="ChooseCategoryRoot_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="更改统一根目录" Style="{StaticResource PrimaryButton}"
                                            Click="ChooseManagedRoot_Click"/>
                                    <Button Content="恢复自动选择" Margin="9,0,0,0"
                                            Padding="15,8" Click="UseAutomaticRoot_Click"/>
                                    <Button Content="清除独立设置" Margin="9,0,0,0"
                                            Padding="15,8" Click="ResetCategoryRoots_Click"/>
                                    <Button Content="打开托管目录" Margin="9,0,0,0"
                                            Padding="15,8" Click="OpenManagedRoot_Click"/>
                                </WrapPanel>

                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="14" Margin="0,16,0,0">
                                    <TextBlock Foreground="#1E40AF" TextWrapping="Wrap">
                                        <Run Text="Local、LocalLow、Roaming 等来源可以分别指定不同磁盘或目录。点击迁移时仍可选择本次自定义位置。"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"
                               Foreground="#64748B" FontSize="11"/>
                    <ProgressBar x:Name="ProgressIndicator" Width="150" Height="4"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Minimum="0" Maximum="100" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
