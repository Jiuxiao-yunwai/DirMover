<WixLocalization
  Culture="zh-CN"
  xmlns="http://schemas.microsoft.com/wix/2006/localization"
>
  <String Id="LaunchApp">启动 DirMover</String>
  <String Id="DowngradeErrorMessage">
    已安装更新版本的 DirMover，无法安装当前旧版本。
  </String>
